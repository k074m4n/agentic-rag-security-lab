# Copy to .env and fill in. Never commit .env.

# ===== Models (any LiteLLM model id) =====
# LITELLM_MODEL is the default for every role; per-role overrides are optional.
LITELLM_MODEL=gemini/gemini-2.5-flash-lite
# LITELLM_MODEL_MANAGER=
# LITELLM_MODEL_KB_WORKER=
# LITELLM_MODEL_CHAT=
# LITELLM_MODEL_CODE=
# LITELLM_FALLBACK_MODEL=
# Via OpenRouter (one key, many providers), e.g.:
# LITELLM_MODEL=openrouter/openai/gpt-oss-120b
# Local model via Ollama, e.g.:
# LITELLM_MODEL=ollama_chat/qwen2.5-coder:7b

# ===== Provider keys (only the ones your models need) =====
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=          # OpenAI-compatible server (e.g. vLLM)

# ===== Paths =====
CODEBASE_PATH=data/sample_codebase
AGENT_WORKSPACE_PATH=data/agent_workspace
SUB_AGENTS_ROOT=data/sub_agents_workspace
RAG_INDEX_DIR=data/rag_index

# ===== Pipeline =====
AUTO_BUILD_KB=true
KB_ORCHESTRATION_MODE=deter     # deter | agent
GLOBAL_RPM=8                    # client-side request rate limit

# ===== Safety switches (defaults are the safe choice) =====
GRADIO_SHARE=false              # true opens a public *.gradio.live tunnel
ENABLE_CODE_AGENT=false         # true lets code_agent run model-written Python locally

# Defense layers to enable at runtime (empty = off). Comma-separated:
#   d1 spotlighting+policy, d2 injection detection, d3 least privilege,
#   d4 parallel tool-call cap + KB sanitization, d5 output redaction.
# e.g. SECURE_LAYERS=d1,d2,d3,d4,d5  — see docs/RESULTS.md for what each stops.
SECURE_LAYERS=
SECURE_MAX_SUBAGENTS=6          # d3 cap on sub-agent fan-out
SECURE_MAX_PARALLEL_CALLS=3     # d4 cap on tool calls per step
